EMAIL_HOST_PASSWORD=your-email-app-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@example.com
FRONTEND_BASE_URL=http://localhost:3000

