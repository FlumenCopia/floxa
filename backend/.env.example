# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Replica Set required for transactions)
DATABASE_URL=mongodb://localhost:27017/floxa_db?replicaSet=rs0

# Security & Session Secrets (Replace with secure random keys in production)
SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Client Portal Security
PORTAL_ACCESS_SALT=your-portal-access-salt-change-in-production
PORTAL_ACCESS_MAX_AGE=86400

# Cookie Configuration
AUTH_ACCESS_COOKIE_NAME=floxa_access
AUTH_REFRESH_COOKIE_NAME=floxa_refresh
PORTAL_ACCESS_COOKIE_NAME=floxa_portal_access
CSRF_COOKIE_NAME=csrftoken
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_CURRENCY=INR

# AI Assistant (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=700

# Email Delivery (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@floxa.local

# Cloud Storage (Optional Vercel Blob token fallback)
BLOB_READ_WRITE_TOKEN=

# Media Storage Directory
# Optional: Absolute path or relative path to media upload storage.
# Defaults to backend/media inside the project if left unset.
MEDIA_ROOT=
