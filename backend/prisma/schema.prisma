datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectStatus {
  created
  discovery
  advance_paid
  concepts
  delivered
  archived
}

enum ConceptStatus {
  draft
  shared
  approved
  changes_requested
}

enum DeliverableStatus {
  draft
  shared
}

enum AgreementStatus {
  draft
  shared
  signature_requested
  signed
  active
  completed
}

enum SignatureMethod {
  typed
  drawn
  uploaded
}

enum MilestoneType {
  advance
  mid
  final
}

enum MilestoneStatus {
  locked
  ready
  requested
  paid
}

enum TransactionStatus {
  created
  verified
  failed
  cancelled
}

enum ActorType {
  client
  consultant
  system
}

enum WebhookProcessingStatus {
  received
  processed
  ignored
  failed
}

// 1. Consultant (User)
model Consultant {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  email        String            @unique
  password     String
  name         String
  company      String?           @default("")
  phone        String?           @default("")
  avatar       String?
  isActive     Boolean           @default(true)
  isStaff      Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  projects     Project[]
  activities   ProjectActivity[]

  @@map("consultants")
}

// 2. Client
model Client {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  companyName String
  sector      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@map("clients")
}

// 3. Project
model Project {
  id                  String                       @id @default(auto()) @map("_id") @db.ObjectId
  consultantId        String                       @db.ObjectId
  consultant          Consultant                   @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  clientId            String                       @db.ObjectId
  client              Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title               String
  companyName         String
  sector              String
  status              ProjectStatus                @default(created)
  projectValue        Float                        @default(0)
  advancePercentage   Int                          @default(50)
  midPercentage       Int                          @default(25)
  finalPercentage     Int                          @default(25)
  revisionLimit       String                       @default("3 revisions")
  portalToken         String                       @unique
  portalPasswordHash  String?                      @default("")
  progress            Int                          @default(0)
  clientSignedOff     Boolean                      @default(false)
  signedOffAt         DateTime?
  isArchived          Boolean                      @default(false)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  clientProfile       ClientProfile?
  discovery           ProjectDiscovery?
  brandDNA            BrandDNA?
  moodboards          Moodboard[]
  concepts            Concept[]
  deliverables        Deliverable[]
  projectAgreement    ProjectAgreement?
  generatedSnapshots  GeneratedAgreementSnapshot[]
  paymentMilestones   PaymentMilestone[]
  paymentTransactions PaymentTransaction[]
  activities          ProjectActivity[]

  @@index([consultantId, isArchived])
  @@map("projects")
}

// 4. ClientProfile
model ClientProfile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @unique @db.ObjectId
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientName  String?  @default("")
  companyName String?  @default("")
  industry    String?  @default("")
  yearStarted Int?
  location    String?  @default("")
  phone       String?  @default("")
  email       String?  @default("")
  website     String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_profiles")
}

// Embedded Discovery Subdocuments
type DiscoverySlider {
  sliderKey  String
  leftLabel  String? @default("")
  rightLabel String? @default("")
  value      Int     @default(50)
}

type DiscoveryCompetitor {
  name   String
  rating String @default("neutral") // like, dislike, neutral
  reason String? @default("")
}

// 5. ProjectDiscovery
model ProjectDiscovery {
  id                String                @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String                @unique @db.ObjectId
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  whatBusinessDoes  String?               @default("")
  targetCustomer    String?               @default("")
  whyChooseUs       String?               @default("")
  brandFeeling      String?               @default("")
  audienceArchetype String?               @default("")
  submittedAt       DateTime?
  sliders           DiscoverySlider[]
  emotions          String[]
  competitors       DiscoveryCompetitor[]
  visualStyles      String[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@map("project_discoveries")
}

// 6. BrandDNA
model BrandDNA {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId                String   @unique @db.ObjectId
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brandPersonalityCluster  String?  @default("")
  businessSummary          String?  @default("")
  targetAudienceSummary    String?  @default("")
  positioningSummary       String?  @default("")
  brandFeelingSummary      String?  @default("")
  visualDirectionSummary   String?  @default("")
  competitorSummary        String?  @default("")
  generatedFromDiscovery   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("brand_dnas")
}

// 7. Moodboard
model Moodboard {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @default("")
  image       String
  isSelected  Boolean  @default(false)
  isShared    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@map("moodboards")
}

// 8. Concept
model Concept {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  projectId      String        @db.ObjectId
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?       @default("")
  image          String?
  file           String?
  version        Int           @default(1)
  status         ConceptStatus @default(draft)
  clientFeedback String?       @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([projectId])
  @@map("concepts")
}

// 9. Deliverable
model Deliverable {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String            @db.ObjectId
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?           @default("")
  file        String
  status      DeliverableStatus @default(draft)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId])
  @@map("deliverables")
}

// Embedded Appendix Subdocument
type AgreementAppendix {
  eventType        String
  eventKey         String?  @default("")
  title            String
  content          String?  @default("{}") // JSON stringified
  sourceActivityId String?
  pdfPageNumber    Int?
  createdAt        DateTime @default(now())
}

// 10. ProjectAgreement
model ProjectAgreement {
  id                            String              @id @default(auto()) @map("_id") @db.ObjectId
  projectId                     String              @unique @db.ObjectId
  project                       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status                        AgreementStatus     @default(draft)
  basicPdfFile                  String?             @default("")
  originalSignedPdfFile         String?             @default("")
  signedPdfFile                 String?             @default("")
  generatedAt                   DateTime?
  sharedAt                      DateTime?
  signatureRequestedAt          DateTime?
  signatureRequestEmailFailedAt DateTime?
  signatureRequestEmailError    String?             @default("")
  signedAt                      DateTime?
  signedEmailFailedAt           DateTime?
  signedEmailError              String?             @default("")
  signerName                    String?             @default("")
  signatureMethod               SignatureMethod?
  signatureImage                String?
  signatureMetadata             String?             @default("{}") // JSON stringified
  appendices                    AgreementAppendix[]
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt

  @@map("project_agreements")
}

// 11. GeneratedAgreementSnapshot
model GeneratedAgreementSnapshot {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId      String    @db.ObjectId
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version        Int
  status         String    @default("draft") // draft, accepted, locked
  snapshot       String    @default("{}") // JSON stringified
  pdfFile        String?   @default("")
  generatedAt    DateTime
  pdfGeneratedAt DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([projectId, version])
  @@map("generated_agreement_snapshots")
}

// 12. PaymentMilestone
model PaymentMilestone {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  projectId    String               @db.ObjectId
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         MilestoneType
  percentage   Int
  amount       Float                @default(0)
  status       MilestoneStatus      @default(locked)
  requestedAt  DateTime?
  paidAt       DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions PaymentTransaction[]

  @@unique([projectId, type])
  @@map("payment_milestones")
}

// 13. PaymentTransaction
model PaymentTransaction {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String            @db.ObjectId
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId       String            @db.ObjectId
  milestone         PaymentMilestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  razorpayOrderId   String            @unique
  razorpayPaymentId String?
  amount            Float
  currency          String            @default("INR")
  status            TransactionStatus @default(created)
  failureReason     String?           @default("")
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([milestoneId, status])
  @@map("payment_transactions")
}

// 14. RazorpayWebhookEvent
model RazorpayWebhookEvent {
  id               String                 @id @default(auto()) @map("_id") @db.ObjectId
  razorpayEventId  String                 @unique
  eventType        String
  payload          String                 @default("{}") // JSON stringified
  processingStatus WebhookProcessingStatus @default(received)
  paymentId        String?                @default("")
  orderId          String?                @default("")
  processedAt      DateTime?
  failureReason    String?                @default("")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([eventType, processingStatus])
  @@map("razorpay_webhook_events")
}

// 15. ProjectActivity
model ProjectActivity {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  projectId        String     @db.ObjectId
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consultantId     String     @db.ObjectId
  consultant       Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  actorType        ActorType
  action           String
  description      String?    @default("")
  metadata         String?    @default("{}") // JSON stringified
  isRead           Boolean    @default(false)
  readAt           DateTime?
  visibleToClient  Boolean    @default(false)
  clientIsRead     Boolean    @default(false)
  clientReadAt     DateTime?
  createdAt        DateTime   @default(now())

  @@index([projectId, createdAt])
  @@index([consultantId, isRead])
  @@map("project_activities")
}
